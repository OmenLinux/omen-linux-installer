<Window x:Class="OmenPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:OmenPrep"
        Title="omen-prep" Icon="Assets/app-icon.ico"
        Width="360" SizeToContent="Height" MaxHeight="700"
        Background="#0A0A0A"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <!-- Same tokens as omenlinux.alessandromarcon.dev (src/app/globals.css :root) -->
        <SolidColorBrush x:Key="BgApp" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BgCard" Color="#181818"/>
        <SolidColorBrush x:Key="BgElevated" Color="#222222"/>
        <SolidColorBrush x:Key="BgHover" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Border" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextDim" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8F8F8F"/>
        <SolidColorBrush x:Key="OmenRed" Color="#E81123"/>
        <SolidColorBrush x:Key="OmenRedDark" Color="#A80F1A"/>
        <LinearGradientBrush x:Key="OmenRedGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C41E3A" Offset="0"/>
            <GradientStop Color="#8B1538" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource OmenRedGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Opacity="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#707070"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="ToggleButton" x:Key="ExpanderHeaderStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,8" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,7,0"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="Advanced" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="90" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Expander" x:Key="PlainExpander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource ExpanderHeaderStyle}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,9"/>
        </Style>
        <Style TargetType="Border" x:Key="PanelBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type local:ResultRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           VerticalAlignment="Top" Margin="0,1,9,0" Width="14">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{Binding GlyphColor}"/>
                    </TextBlock.Foreground>
                </TextBlock>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontSize="11.5" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={x:Static local:NullToCollapsedConverter.Instance}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource BgApp}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#111111">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/app-icon-small.png" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock Text="Omen Linux Installer" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource BorderSoft}" Height="1"/>

        <ProgressBar x:Name="BusyBar" Grid.Row="2" Height="2" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource OmenRed}" IsIndeterminate="True" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,16,18,16">

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Get your Omen ready for Linux" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,12">
                        Detects your model, patches its ACPI tables, and injects the fix into
                        a Linux install ISO you provide.
                    </TextBlock>
                    <Button x:Name="OneClickButton" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Click="OnOneClickClick">
                        <TextBlock Text="Fix my laptop for Linux"/>
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource PanelBox}" x:Name="QuickProgressPanel" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Progress" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="QuickProgressList" ItemTemplate="{StaticResource ResultRowTemplate}"/>
                        <StackPanel x:Name="QuickResultActions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button Content="Show in folder" Style="{StaticResource SecondaryButton}" Click="OnShowResultInFolderClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander x:Name="AdvancedExpander" Style="{StaticResource PlainExpander}" IsExpanded="False" Margin="0,2,0,0">
                    <StackPanel Margin="0,6,0,0">

                        <Border Style="{StaticResource PanelBox}">
                            <StackPanel>
                                <TextBlock Text="1 · Detect hardware" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}">Reads your exact vendor/model/BIOS via WMI.</TextBlock>
                                <Button Content="Detect" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnDetectClick"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Model" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ModelText" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SerialText" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="BIOS" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BiosText" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIOS date" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="BiosDateText" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBox}">
                            <StackPanel>
                                <TextBlock Text="2 · Dump ACPI tables" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    Reads DSDT/SSDT from HKLM\HARDWARE\ACPI — no third-party tool needed.
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="DumpPathBox" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="Browse…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnBrowseDumpClick"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="Dump" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11.5" Click="OnDumpClick"/>
                                </Grid>
                                <ItemsControl x:Name="DumpResultsList" ItemTemplate="{StaticResource ResultRowTemplate}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBox}">
                            <StackPanel>
                                <TextBlock Text="3 · Patch" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    Disassembles, applies the standard HP OMEN Linux fixes, and recompiles —
                                    the same iasl build and rules the web patcher uses, run locally.
                                </TextBlock>
                                <Button Content="Patch dumped DSDT" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11.5" HorizontalAlignment="Left" Click="OnPatchClick"/>
                                <ItemsControl x:Name="PatchStepsList" ItemTemplate="{StaticResource ResultRowTemplate}" Margin="0,9,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button x:Name="SavePatchedButton" Content="Save patched DSDT.aml…" Style="{StaticResource SecondaryButton}"
                                            IsEnabled="False" Click="OnSavePatchedClick"/>
                                    <Button Content="Load DSDT.aml…" Style="{StaticResource SecondaryButton}"
                                            Margin="8,0,0,0" Click="OnLoadAmlClick"
                                            ToolTip="Use a prebuilt AML (e.g. our-patched.aml or the GitHub golden) for ISO inject"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PanelBox}">
                            <StackPanel>
                                <TextBlock Text="4 · Install into a Linux ISO" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    Prepends the patched table onto the ISO's initramfs and relocates only that
                                    file's directory record — everything else, including BIOS/UEFI boot, is untouched.
                                </TextBlock>
                                <Grid Margin="0,0,0,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" x:Name="SourceIsoBox" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                    <Button Grid.Row="1" Content="Choose ISO…" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnChooseIsoClick"/>
                                </Grid>
                                <Button x:Name="InjectButton" Content="Inject &amp; save as…" Style="{StaticResource PrimaryButton}" Padding="14,6" FontSize="11.5"
                                        IsEnabled="False" HorizontalAlignment="Left" Click="OnInjectClick"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Expander>

                <Border Background="#101010" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="4" Padding="9,7" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
