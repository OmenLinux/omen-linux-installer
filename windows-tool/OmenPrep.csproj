<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>OmenPrep</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscUtils.Iso9660" Version="0.16.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <!-- Open-source Wasm runtime (bytecodealliance/wasmtime) for ACPICA iasl.wasm -->
    <PackageReference Include="Wasmtime" Version="22.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled into the assembly so PublishSingleFile is truly one .exe -->
    <EmbeddedResource Include="Iasl\iasl.wasm" LogicalName="OmenPrep.Iasl.iasl.wasm" />
    <EmbeddedResource Include="Resources\apply-omen-acpi.sh" LogicalName="OmenPrep.apply-omen-acpi.sh" />
    <EmbeddedResource Include="Resources\post-install-omen.sh" LogicalName="OmenPrep.post-install-omen.sh" />
    <Resource Include="Assets\app-icon.ico" />
    <Resource Include="Assets\app-icon-small.png" />
  </ItemGroup>

</Project>
